---
import Layout from '../layouts/Primary.astro';
import '../styles/work.css';

const work = [
    {
        name: 'PFRI: Codename REDUX',
        role: 'Lead Director (2022-Present)',
        desc: 'A massive-sized Roblox game dedicated to controlling & maintaining the Proton Reactor Mark 3.',
        images: ['/img/work/pfri-1.png', '/img/work/pfri-2.png', '/img/work/pfri-3.jpg', '/img/work/pfri-4.jpg'],
        href: 'https://www.roblox.com/games/9165821457'
    },
    {
        name: 'OnlyOneMessage',
        role: 'Lead Developer (2024-Present)',
        desc: 'A feature-rich Discord bot that allows full management over text channels, including permanent slowmodes, logging & more.',
        images: ['/img/work/oom-1.png', '/img/work/oom-2.png', '/img/work/oom-3.png'],
        href: 'https://onlyonemessage.as2bax.dev'
    },
    {
        name: 'PONGETITIVE',
        role: 'Lead Developer (2026)',
        desc: 'Pong, taken too seriously. Events, power-ups, competitive opponents and more.',
        images: ['/img/work/pong-1.png', '/img/work/pong-2.png'],
        href: 'https://github.com/As2Bax/PONGETITIVE'
    },
    {
        name: 'Object Show Elevator',
        role: 'Building, Testing & Scripting (2024-Present)',
        desc: 'A casual Roblox random elevator game based on object shows such as BFDI, II, and more!',
        images: ['/img/work/ose-1.png', '/img/work/ose-2.png', '/img/work/ose-3.png', '/img/work/ose-4.png'],
        href: 'https://www.roblox.com/games/17321542904'
    },
    {
        name: 'Velocity Science Energy Generation Complex',
        role: 'Development (2026-Present)',
        desc: 'An evil spooky horror game that will shock the shockings out of your shockings...',
        images: ['/img/work/vsegc-1.png', '/img/work/vsegc-2.png'],
        href: 'https://discord.gg/c7Cm8fPK88'
    },
];
---

<Layout title="Work - as2bax.dev">
    <h1>Work</h1>
    <div class="line"></div>

    <p>
        All of the projects I own and/or work on are listed below. If you are interested in working with me, feel free to <a href="/contact">reach out!</a>
    </p>

    <div class="work-cards">
        {work.map((work) => (
            <article class="work-card">
                <div class="work-media" data-slideshow>
                    {work.images.map((src, i) => (
                        <img
                            src={src}
                            alt={`${work.name} ${i + 1}`}
                            class={i === 0 ? 'slide active' : 'slide'}
                        />
                    ))}

                    {work.images.length > 1 && (
                        <button class="slide-btn prev" type="button" aria-label="Previous image">‹</button>
                        <button class="slide-btn next" type="button" aria-label="Next image">›</button>

                        <div class="slide-dots">
                            {work.images.map((_, i) => (
                                <span class={i === 0 ? 'dot active' : 'dot'}></span>
                            ))}
                        </div>
                    )}
                </div>

                <div class="work-info">
                    {work.role && <span class="work-role">{work.role}</span>}

                    <h2>{work.name}</h2>
                    <p>{work.desc}</p>

                    {work.href && (
                        <a class="work-link" href={work.href} target="_blank" rel="noopener noreferrer">
                            Learn more <span aria-hidden="true">→</span>
                        </a>
                    )}
                </div>
            </article>
        ))}
    </div>
</Layout>

<script>
    document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((show) => {
        const slides = show.querySelectorAll('.slide');
        const dots = show.querySelectorAll('.dot');
        let current = 0;
        let timer: number | undefined;

        const go = (n: number) => {
            slides[current].classList.remove('active');
            dots[current]?.classList.remove('active');

            current = (n + slides.length) % slides.length;

            slides[current].classList.add('active');
            dots[current]?.classList.add('active');
        };

        const start = () => {
            if (slides.length < 2) return;

            stop();
            timer = window.setInterval(() => go(current + 1), 4000);
        };

        const stop = () => window.clearInterval(timer);

        show.querySelector('.prev')?.addEventListener('click', () => go(current - 1));
        show.querySelector('.next')?.addEventListener('click', () => go(current + 1));

        show.addEventListener('mouseenter', stop);
        show.addEventListener('mouseleave', start);

        start();
    });
</script>