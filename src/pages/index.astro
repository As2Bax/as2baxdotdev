---
import Layout from '../layouts/Primary.astro';
import '../styles/home.css';

const experience = [
    { name: 'Luau', img: '/img/experience/luau.png' },
    { name: 'Python', img: '/img/experience/python.png' },
    { name: 'JavaScript', img: '/img/experience/javascript.png' },
	{ name: 'Docker', img: '/img/experience/docker.svg' },
	{ name: 'HTML5', img: '/img/experience/html5.svg' },
	{ name: 'Astro', img: '/img/experience/astro.png' },
];

const links = [
    { name: 'GitHub', img: '/img/links/github.png', href: 'https://github.com/As2Bax' },
	{ name: 'Roblox', img: '/img/links/roblox.png', href: 'https://roblox.com/users/533231763' },
];
---

<Layout title="Home - as2bax.dev">
    <h1>Hello world!</h1>
    <div class="line"></div>

	<p>
		I'm As2Bax, you may also know me as Linode or Vqel.
		I taught myself how to code in <b>2020</b> with the Luau language and I've been expanding ever since.
	</p>

	<p>
		I have a passion for making things not only function but also visually pleasing. My primary project is <a href="https://www.roblox.com/games/9165821457" target="_blank" rel="noopener noreferrer">PFRI: Codename REDUX</a>, a massive-sized Roblox game
		dedicated to controlling & maintaining the Proton Reactor Mark 3.
	</p>

	<p>
		Other than just making Roblox games, I also dedicate my time to making useful applications such as <a href="https://onlyonemessage.as2bax.dev" target="_blank" rel="noopener noreferrer">OnlyOneMessage</a>,
		a Discord bot that allows further management over channels.
	</p>

	<p>
		Want to get in touch? You can either DM me on Discord <i>(@vqel)</i> or email <a href="mailto:me@as2bax.dev">me@as2bax.dev</a>!
	</p>

	<div class="experience-cards">
		{experience.map((item) => (
			<div class="experience-card" title={item.name}>
				<img src={item.img} alt={item.name} />
			</div>
		))}
	</div>

	<div class="link-cards">
		{links.map((item) => (
			<a class="link-card" href={item.href} target="_blank" rel="noopener noreferrer">
				<img src={item.img} alt="" />
				<span>{item.name}</span>
			</a>
		))}
	</div>

	<div class="clock">
		<button class="clock-btn" type="button" aria-describedby="clock-tip">
			<span id="clock-time"></span><small id="clock-ampm"></small>
		</button>

		<div class="clock-tip" id="clock-tip" role="tooltip"></div>
	</div>
</Layout>

<script>
	const zone = 'America/Chicago';

	const timeEl = document.querySelector<HTMLElement>('#clock-time');
	const ampmEl = document.querySelector<HTMLElement>('#clock-ampm');
	const tipEl = document.querySelector<HTMLElement>('#clock-tip');

	const offsetOf = (tz: string, date: Date) => {
		const list = new Intl.DateTimeFormat('en-US', {
			timeZone: tz,
			hourCycle: 'h23',
			year: 'numeric',
			month: 'numeric',
			day: 'numeric',
			hour: 'numeric',
			minute: 'numeric',
			second: 'numeric',
		}).formatToParts(date);

		const get = (type: string) => Number(list.find((p) => p.type === type)?.value);

		const asUtc = Date.UTC(get('year'), get('month') - 1, get('day'), get('hour'), get('minute'), get('second'));

		return Math.round((asUtc - Math.floor(date.getTime() / 1000) * 1000) / 60000);
	};

	const tick = () => {
		const now = new Date();

        const list = new Intl.DateTimeFormat('en-US', {
            timeZone: zone,
            hour: 'numeric',
            minute: '2-digit',
            hour12: true,
            timeZoneName: 'short',
        }).formatToParts(now);

		const get = (type: string) => list.find((p) => p.type === type)?.value ?? '';

		const diff = -now.getTimezoneOffset() - offsetOf(zone, now);
		const hours = Math.abs(diff) / 60;
		const amount = Number.isInteger(hours) ? hours : hours.toFixed(1);

		if (timeEl) timeEl.textContent = `${get('hour')}:${get('minute')}`;
        if (ampmEl) ampmEl.textContent = `${get('dayPeriod')} ${get('timeZoneName')}`;

		if (tipEl) {
			tipEl.textContent = diff === 0
				? "You're in the same timezone as me!"
				: `You're ${amount} hour${amount !== 1 ? 's' : ''} ${diff > 0 ? 'ahead of me' : 'behind me'}`;
		}
	};

	tick();
	setInterval(tick, 1000);
</script>