---
import Layout from '../layouts/Primary.astro';
import '../styles/home.css';

const exp = [
    { name: 'Luau', img: '/img/exp/luau.png' },
    { name: 'Python', img: '/img/exp/python.png' },
    { name: 'JavaScript', img: '/img/exp/javascript.png' },
	{ name: 'Docker', img: '/img/exp/docker.svg' },
	{ name: 'HTML5', img: '/img/exp/html5.svg' },
	{ name: 'Astro', img: '/img/exp/astro.png' },
];

const links = [
    { name: 'GitHub', img: '/img/links/github.png', href: 'https://github.com/As2Bax' },
	{ name: 'Roblox', img: '/img/links/roblox.png', href: 'https://roblox.com/users/533231763' },
];
---

<Layout title="Home - as2bax.dev">
    <h1>Hello world!</h1>
    <div class="line"></div>

	<p>
		I'm As2Bax, you may also know me as Linode or Vqel.
		I taught myself how to code in <b>2020</b> with the Luau language and I've been expanding ever since.
	</p>

	<p>
		I have a passion for making things not only function but also visually pleasing. My primary project is <a href="https://www.roblox.com/games/9165821457" target="_blank" rel="noopener noreferrer">PFRI: Codename REDUX</a>, a massive-sized Roblox game
		dedicated to controlling & maintaining the Proton Reactor Mark 3.
	</p>

	<p>
		Other than just making Roblox games, I also dedicate my time to making useful applications such as <a href="https://onlyonemessage.as2bax.dev" target="_blank" rel="noopener noreferrer">OnlyOneMessage</a>,
		a Discord bot that allows further management over channels.
	</p>

	<p>
		Want to get in touch? You can either DM me on Discord <i>(@vqel)</i> or email <a href="mailto:me@as2bax.dev">me@as2bax.dev</a>!
	</p>

	<div class="exp-cards">
		{exp.map((item) => (
			<div class="exp-card" title={item.name}>
				<img src={item.img} alt={item.name} />
			</div>
		))}
	</div>

	<div class="link-cards">
		{links.map((item) => (
			<a class="link-card" href={item.href} target="_blank" rel="noopener noreferrer">
				<img src={item.img} alt="" />
				<span>{item.name}</span>
			</a>
		))}
	</div>
</Layout>